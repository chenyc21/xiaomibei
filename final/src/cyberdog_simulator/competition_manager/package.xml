<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>competition_manager</name>
  <version>1.0.0</version>
  <description>
    Global state machine and stage handlers for the CyberDog 2026 competition.
    Orchestrates all 6 competition stages.
  </description>
  <maintainer email="team@example.com">Competition Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>competition_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>tf2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
