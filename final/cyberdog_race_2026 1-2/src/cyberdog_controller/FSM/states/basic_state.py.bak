class Walking_Forward_LidarEnhanced(Basic_State):
    """
    LiDAR + 视觉双重感知的前进状态（石板路专用）

    特性：
    1. 激光雷达检测前方障碍物 → 自动切换超高抬腿步态（motion_id=22）跨越石头
    2. 摄像头跟踪赛道中心线 → 动态纠偏
    3. 智能卡死检测 → 极小后退（0.25s）+ 超高抬腿前进脱困
       （不会后退太多，避免退到后面石头上）
    4. 无视觉/无LiDAR时也能可靠盲走
    """
    def __init__(self, duration=120, motion_id=16):
        super().__init__()
        self.name = "Walking Forward LiDAR Enhanced"
        self.duration = duration
        self.default_motion = motion_id      # 默认步态（高抬腿慢走）
        self.high_step_motion = 22            # 超高抬腿（跨越石头用，step_height=0.80）
        self.extreme_step_motion = 25         # 极限高抬腿（大石头脱困用，step_height=1.00）
        self.recovery_back_motion = 24        # 极小后退（脱困用）
        self.recovery_forward_motion = 25     # 脱困后前进用（极限高抬腿）

        # 视觉跟踪参数
        self.steering_threshold = 15
        self.safe_margin = 35
        self.critical_margin = 5  # 进一步降低灵敏度，配合下方的“跨越优先”逻辑使用

        # 卡死检测参数
        self.stuck_check_interval = 5.0
        self.stuck_dist_threshold = 3
        self.last_dist = -1
        self.last_check_time = 0
        self.stuck_count = 0

        # LiDAR 缓存
        self._lidar_cache = None
        self._lidar_cache_time = 0
        self._lidar_cooldown = 0.5

        # 障碍物计数
        self.obstacle_count = 0
        self.no_obstacle_count = 0

        # 石阵置信度计数器 (0.0 ~ 1.0)
        # 快速上升（检测到石头时+0.3），缓慢衰减（每帧-0.02）
        # 用于抑制因身体倾斜导致的虚假边界警告
        self.stone_confidence = 0.0
        self.STONE_CONFIDENCE_RISE = 0.3    # 检测到石头时单次增加量
        self.STONE_CONFIDENCE_DECAY = 0.02  # 未检测到石头时单次衰减量
        self.STONE_CONFIDENCE_HIGH = 0.6    # 高于此阈值：完全禁止后退
        self.STONE_CONFIDENCE_MID = 0.3     # 高于此阈值：边界警告降级为侧移

    def _get_lidar_data(self):
        """获取 LiDAR 数据（带缓存，避免频繁创建/销毁节点）"""
        now = time.time()
        if self._lidar_cache is not None and (now - self._lidar_cache_time) < self._lidar_cooldown:
            return self._lidar_cache

        try:
            from ...camera.path_scanner import lidar_scanner_main
            data = lidar_scanner_main(timeout=1.5)
            if data and data.get('scan_available', False):
                self._lidar_cache = data
                self._lidar_cache_time = now
                return data
        except Exception as e:
            pass

        if self._lidar_cache is not None:
            return self._lidar_cache
        return {'scan_available': False, 'front_blocked': False, 'stone_warning': False,
                'clear_path': True, 'front_distance': float('inf'),
                'left_distance': float('inf'), 'right_distance': float('inf')}

    def execute(self):
        print(f"Executing {self.name} with LiDAR assistance (default: {self.default_motion}, high_step: {self.high_step_motion})")

        from ...camera.path_scanner import check_camera_ready, path_scanner_main, CenterOffsetScanner

        camera_ok = check_camera_ready(timeout=1.0)

        self._ros2_manager.init()
        sim_clock = self._ros2_manager.get_clock()

        try:
            _start_time = sim_clock.get_sim_time()
            wait_count = 0
            while _start_time is None:
                if wait_count % 5 == 0:
                    print(f"Waiting for /clock topic... (Attempt {wait_count})")
                time.sleep(1.0)
                _start_time = sim_clock.get_sim_time()
                wait_count += 1
            start_time = _start_time.nanosec / 1e9 + _start_time.sec
            self.last_check_time = start_time
            had_vision = False
            blind_msg_count = 0

            # 初始查询一次 LiDAR
            lidar_data = self._get_lidar_data()
            lidar_available = lidar_data.get('scan_available', False)
            if lidar_available:
                print(f"{self.name}: LiDAR 已就绪，前方距离={lidar_data.get('front_distance', 'N/A'):.2f}m" if isinstance(lidar_data.get('front_distance'), float) else f"{self.name}: LiDAR 已就绪")
            else:
                print(f"{self.name}: LiDAR 未就绪，仅使用视觉+盲走模式")

            while True:
                _current_time = sim_clock.get_sim_time()
                current_time = _current_time.nanosec / 1e9 + _current_time.sec

                if current_time - start_time >= self.duration:
                    print("Duration reached, stopping.")
                    break

                try:
                    # === LiDAR 感知 ===
                    lidar_data = self._get_lidar_data()
                    front_blocked = lidar_data.get('front_blocked', False)
                    front_dist = lidar_data.get('front_distance', float('inf'))
                    left_dist = lidar_data.get('left_distance', float('inf'))
                    right_dist = lidar_data.get('right_distance', float('inf'))
                    stone_warning = (front_dist < 0.35 and front_dist >= 0.22)

                    # 更新石阵置信度（快速上升、缓慢衰减）
                    if front_blocked or stone_warning:
                        self.stone_confidence = min(1.0, self.stone_confidence + self.STONE_CONFIDENCE_RISE)
                    else:
                        self.stone_confidence = max(0.0, self.stone_confidence - self.STONE_CONFIDENCE_DECAY)

                    # === 视觉感知 ===
                    if not camera_ok:
                        # 无摄像头：纯盲走 + LiDAR避障
                        if front_blocked:
                            self.obstacle_count += 1
                            self.no_obstacle_count = 0
                            if self.obstacle_count >= 2:
                                # LiDAR持续检测到前方障碍 → 极限高抬腿跨越
                                step = self.extreme_step_motion if front_dist < 0.22 else self.high_step_motion
                                print(f"LiDAR: 前方障碍 {front_dist:.2f}m，启用{'极限' if front_dist < 0.22 else '超高'}抬腿跨越！")
                                self.locomotion.set_motion(step)
                                time.sleep(0.35)
                                self.obstacle_count = 0
                            else:
                                self.locomotion.set_motion(self.default_motion)
                                time.sleep(0.1)
                        else:
                            self.obstacle_count = max(0, self.obstacle_count - 0.5)
                            self.no_obstacle_count += 1
                            self.locomotion.set_motion(self.default_motion)
                            time.sleep(0.1)

                        blind_msg_count += 1
                        if blind_msg_count % 50 == 0:
                            print(f"{self.name}: 盲走模式 (已走{current_time - start_time:.1f}s, LiDAR={'OK' if lidar_data.get('scan_available') else 'N/A'})")

                        if current_time - self.last_check_time > self.stuck_check_interval:
                            self.last_check_time = current_time
                        continue

                    # === 有摄像头 ===
                    data = path_scanner_main(CenterOffsetScanner, timeout=1.0)
                    left_edge = data.get('left_edge') if data else None
                    right_edge = data.get('right_edge') if data else None
                    has_track = (left_edge is not None) or (right_edge is not None)

                    if not has_track:
                        if had_vision:
                            print(f"{self.name}: 视觉信号丢失，站立等待...")
                            self.locomotion.set_motion(1)
                            time.sleep(0.5)
                        else:
                            self.locomotion.set_motion(1)
                            time.sleep(0.2)
                            blind_msg_count += 1
                            if blind_msg_count % 30 == 0:
                                print(f"{self.name}: 等待视觉... (已等{current_time - start_time:.1f}s)")

                        if current_time - self.last_check_time > self.stuck_check_interval:
                            self.last_check_time = current_time
                        continue

                    if not had_vision:
                        print(f"{self.name}: 视觉已恢复！")
                    had_vision = True

                    offset = data.get('center_offset', 0)
                    dist = data.get('center_distance', 0)
                    center_x = 160

                    # === 1. 紧急边界避障（石阵置信度分级响应） ===
                    if (left_edge is not None and (center_x - left_edge) < self.critical_margin) or \
                       (right_edge is not None and (right_edge - center_x) < self.critical_margin):

                        # 石阵置信度高 → 相机边界警告大概率是倾斜造成的误判，禁止后退
                        if self.stone_confidence >= self.STONE_CONFIDENCE_HIGH:
                            print(f"{self.name}: 石阵高置信度({self.stone_confidence:.2f})，边界警告降级为前冲 (L:{left_edge}, R:{right_edge})")
                            if left_edge is not None and (center_x - left_edge) < self.critical_margin:
                                self.locomotion.set_motion(14)  # 右移
                                time.sleep(0.10)
                            else:
                                self.locomotion.set_motion(13)  # 左移
                                time.sleep(0.10)
                            self.locomotion.set_motion(25)  # 极限抬腿前冲
                            time.sleep(0.15)

                        # 石阵置信度中等 → 谨慎侧移，不后退
                        elif self.stone_confidence >= self.STONE_CONFIDENCE_MID:
                            print(f"{self.name}: 石阵中置信度({self.stone_confidence:.2f})，侧移避让不后退 (L:{left_edge}, R:{right_edge})")
                            if left_edge is not None and (center_x - left_edge) < self.critical_margin:
                                self.locomotion.set_motion(14)
                                time.sleep(0.12)
                            else:
                                self.locomotion.set_motion(13)
                                time.sleep(0.12)
                            # 中置信度下只侧移，不强制前冲（避免真实边界时冲出赛道）

                        # 前方确有 LiDAR 障碍 → 即使置信度低，也优先跨越而非后退
                        elif front_blocked or stone_warning:
                            print(f"{self.name}: LiDAR检测到障碍+边界警告，抬腿跨越 (L:{left_edge}, R:{right_edge})")
                            step = self.extreme_step_motion if front_blocked else self.high_step_motion
                            self.locomotion.set_motion(step)
                            time.sleep(0.35)

                        # 空旷路面 + 低置信度 → 真正需要后退的情况，允许后退
                        else:
                            print(f"{self.name}: CRITICAL 置信度({self.stone_confidence:.2f}) 空旷路面边界警告，极小后退...")
                            self.locomotion.set_motion(self.recovery_back_motion)
                            time.sleep(0.25)
                        continue

                    # === 2. LiDAR 前方障碍物处理 ===
                    # 近距障碍(<0.22m) → 极限高抬腿；中距障碍(0.22-0.35m) → 超高抬腿
                    if front_blocked or stone_warning:
                        if front_blocked:
                            self.obstacle_count += 1
                        else:
                            self.obstacle_count += 0.5  # 中距警告累积较慢
                        self.no_obstacle_count = 0
                        if self.obstacle_count >= 2:
                            # 持续检测到障碍 → 抬腿跨越
                            step_motion = self.extreme_step_motion if front_blocked else self.high_step_motion
                            print(f"LiDAR: 前方{'障碍' if front_blocked else '石头'} {front_dist:.2f}m，{'极限' if front_blocked else '超高'}抬腿跨越！")
                            # 根据左右空间决定偏转方向
                            if left_dist > right_dist and left_dist > 0.5:
                                self.locomotion.set_motion(step_motion)
                                time.sleep(0.25)
                                self.locomotion.set_motion(13)
                                time.sleep(0.12)
                            elif right_dist > left_dist and right_dist > 0.5:
                                self.locomotion.set_motion(step_motion)
                                time.sleep(0.25)
                                self.locomotion.set_motion(14)
                                time.sleep(0.12)
                            else:
                                self.locomotion.set_motion(step_motion)
                                time.sleep(0.35)
                            self.obstacle_count = 0
                            continue
                    else:
                        self.obstacle_count = max(0, self.obstacle_count - 0.5)
                        self.no_obstacle_count += 1

                    # === 3. 卡死检测 ===
                    if current_time - self.last_check_time > self.stuck_check_interval:
                        is_stuck = False
                        if self.last_dist != -1:
                            dist_change = abs(dist - self.last_dist)
                            if dist_change < self.stuck_dist_threshold:
                                is_stuck = True

                        if is_stuck:
                            self.stuck_count += 1
                            print(f"Stuck #{self.stuck_count}/2 (dist_change={dist - self.last_dist:.1f}px)")

                            if self.stuck_count >= 2:
                                print("Recovery: wiggle + micro-backup + extreme high-step...")
                                # 1. 优先侧移摇摆脱困（不后退，避免退到后面石头上）
                                self.locomotion.set_motion(13)
                                time.sleep(0.15)
                                self.locomotion.set_motion(14)
                                time.sleep(0.15)
                                # 2. 仅当LiDAR显示后方畅通时才极小后退
                                lidar_check = self._get_lidar_data()
                                rear_clear = lidar_check.get('front_distance', float('inf')) > 0.4
                                if rear_clear:
                                    self.locomotion.set_motion(self.recovery_back_motion)
                                    time.sleep(0.10)  # 极短后退，仅0.10s
                                # 3. 极限高抬腿前冲（motion_id=25, step_height=1.00）
                                self.locomotion.set_motion(self.recovery_forward_motion)
                                time.sleep(0.5)
                                # 4. 根据LiDAR微调方向避开障碍
                                if left_dist > right_dist and left_dist < 2.0:
                                    self.locomotion.set_motion(13)
                                    time.sleep(0.15)
                                elif right_dist < 2.0:
                                    self.locomotion.set_motion(14)
                                    time.sleep(0.15)
                                self.stuck_count = 0
                                print("Recovery done, resuming forward.")
                        else:
                            self.stuck_count = max(0, self.stuck_count - 1)

                        self.last_dist = dist
                        self.last_check_time = current_time

                    # === 4. 正常行走：视觉纠偏 + LiDAR辅助选择步态 ===
                    # 边界软避障
                    boundary_steer = 0
                    if left_edge is not None and (center_x - left_edge) < self.safe_margin:
                        boundary_steer = 12
                    elif right_edge is not None and (right_edge - center_x) < self.safe_margin:
                        boundary_steer = 11

                    # 选择步态：路径畅通时用默认步态，否则用高抬腿
                    current_motion = self.default_motion
                    if front_blocked and self.no_obstacle_count < 3:
                        current_motion = self.high_step_motion

                    if boundary_steer != 0:
                        self.locomotion.set_motion(boundary_steer)
                        time.sleep(0.08)
                    elif offset > self.steering_threshold:
                        self.locomotion.set_motion(12)  # 右转纠偏
                        time.sleep(0.08)
                    elif offset < -self.steering_threshold:
                        self.locomotion.set_motion(11)  # 左转纠偏
                        time.sleep(0.08)
                    else:
                        self.locomotion.set_motion(current_motion)
                        time.sleep(0.05)

                except Exception as e:
                    print(f"LiDAR Enhanced Walk error: {str(e)}")
                    self.locomotion.set_motion(self.default_motion)
                    time.sleep(0.1)

        finally:
            self._ros2_manager.shutdown()


